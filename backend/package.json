{
  "name": "kogo-backend",
  "version": "2.0.0",
  "description": "Backend for Kogo Belajar (offline-first research sync, ElevenLabs TTS proxy, researcher metrics)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "node --test --test-reporter=spec \"dist/test/unit/**/*.test.js\"",
    "pretest:integration": "npm run build",
    "test:integration": "node --test --test-reporter=spec --test-concurrency=1 \"dist/test/integration/**/*.test.js\"",
    "test:all": "npm test && npm run test:integration",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx src/scripts/check_db.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:check:prod": "node dist/scripts/check_db.js",
    "db:seed:curriculum": "tsx src/scripts/seed_curriculum.ts",
    "db:seed:curriculum:prod": "node dist/scripts/seed_curriculum.js",
    "db:setup:e2e": "tsx src/scripts/setup_e2e_db.ts"
  },
  "keywords": [
    "kogo",
    "voice-learning",
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
