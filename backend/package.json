{
  "name": "kogo-backend",
  "version": "1.0.0",
  "description": "Production backend and data sync foundation for Kogo Voice Learning",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --test dist/test/health.test.js dist/test/migration.test.js dist/test/curriculum_seed.test.js dist/test/auth_research.test.js dist/test/voice_proxy.test.js dist/test/e2e_sync_integration.test.js",
    "test:ts": "tsx --test src/**/*.test.ts",
    "lint": "tsc --noEmit",
    "db:check": "tsx src/scripts/check_db.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:check:prod": "node dist/scripts/check_db.js",
    "db:seed:curriculum": "tsx src/scripts/seed_curriculum.ts",
    "db:seed:curriculum:prod": "node dist/scripts/seed_curriculum.js",
    "db:setup:e2e": "tsx src/scripts/setup_e2e_db.ts",
    "test:e2e": "tsx --test src/test/e2e_sync_integration.test.ts"
  },
  "keywords": [
    "kogo",
    "voice-learning",
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "type": "module"
}
