# =============================================================================
# Kogo Belajar backend - environment variables
# Copy to `.env` for local development (`cp .env.example .env`). In Coolify, set
# these in the resource's "Environment Variables" tab instead. Never commit real
# secrets. Values below are safe examples/placeholders only.
# =============================================================================

# --- Server -------------------------------------------------------------------
# production (default when unset) | development | test. Production requires a
# real JWT_SECRET. For local development uncomment NODE_ENV=development (stack
# traces in 500 responses, binds to 127.0.0.1); never use it on a public server.
# NODE_ENV=development
# Bind address. Default: 0.0.0.0 in production (container), 127.0.0.1 otherwise.
HOST=
# Port the HTTP server listens on inside the container (Coolify/Traefik -> 4000).
PORT=4000
# Prefix for every route.
API_PREFIX=/api
# Which peers may set X-Forwarded-For (client IP for rate limits). Default:
# "loopback, linklocal, uniquelocal" = only private-network peers such as
# Traefik on the Docker network, so a client that reaches the container
# directly cannot spoof its IP. `false` = trust none. A hop count (e.g. 1)
# trusts ANY peer and is only safe if the port is never reachable directly.
# Behind Cloudflare -> Traefik, add Cloudflare's IP ranges to this list.
TRUST_PROXY=loopback, linklocal, uniquelocal
# Comma separated browser origins allowed by CORS. Empty = CORS disabled (the
# Android app does not need CORS). Credentials are never allowed.
CORS_ORIGIN=
# Version reported by GET /api/health.
APP_VERSION=2.0.0

# --- Database (PostgreSQL 16) -----------------------------------------------------
# Either a full connection URL (takes precedence; URL-encode special characters
# in the password) ...
DATABASE_URL=
# ... or individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kogo_research
DB_USER=postgres
DB_PASSWORD=
# TLS to PostgreSQL (managed databases). Certificates are verified unless
# DB_SSL_REJECT_UNAUTHORIZED=false.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MILLIS=30000
DB_CONNECTION_TIMEOUT_MILLIS=5000

# --- Startup --------------------------------------------------------------------
# Run migrations + reference data seed (src/data/vocabulary.json) + admin
# bootstrap on start. Guarded by a PostgreSQL advisory lock.
RUN_MIGRATIONS_ON_START=true
# How long to wait for PostgreSQL to accept connections on start (seconds).
DB_WAIT_SECONDS=60

# --- Auth -----------------------------------------------------------------------
# REQUIRED in production: >= 32 random characters. Generate with:
#   openssl rand -hex 48
# When unset outside production a random per-process secret is used. Known
# public values (old defaults/placeholders) are ignored in every environment.
JWT_SECRET=
# Access token lifetime for researcher/admin logins (s|m|h|d).
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Lifetime of device tokens issued by POST /api/v2/devices/register.
DEVICE_TOKEN_TTL=180d
BCRYPT_SALT_ROUNDS=10
# Admin account created/updated on every start (bcrypt hashed). Public
# registration is child-only, so this is how the first staff account is made.
# Password: at least 12 characters in production.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Devices (API v2) -------------------------------------------------------------
# Optional shared enrollment key for field-test builds. When set, registering a
# NEW device requires the header `X-Enrollment-Key: <value>` (>= 16 chars) and
# the device is approved immediately. When empty, registration is open but new
# devices stay "pending": their data is stored but excluded from metrics/exports
# and they cannot use the voice proxy until a researcher approves them
# (POST /api/v2/research/devices/:deviceId/approve).
DEVICE_ENROLLMENT_KEY=
# Device timestamps more than this many hours in the future are rejected per item.
SYNC_MAX_CLOCK_SKEW_HOURS=24

# --- Rate limits ----------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Login/registration attempts per 15 minutes per IP.
RATE_LIMIT_AUTH_MAX=10
# Voice proxy requests per minute per device/user.
RATE_LIMIT_VOICE_PER_MIN=60
# Voice proxy requests per minute per client IP (applies before authentication).
RATE_LIMIT_VOICE_PER_IP_PER_MIN=120
# Sync requests per minute per device.
RATE_LIMIT_SYNC_PER_MIN=60
# Device registrations per hour per IP.
RATE_LIMIT_DEVICE_REGISTER_PER_HOUR=20

# --- ElevenLabs (optional premium TTS / STT proxy) --------------------------------
# Leave ELEVENLABS_API_KEY empty to disable: voice endpoints then return
# 503 NOT_CONFIGURED and the app keeps using on-device TTS/STT.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
# Voice used for TTS (pick an Indonesian-capable voice in the ElevenLabs Voice
# Library). Required for TTS; there is no built-in default voice.
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_DEFAULT_MODEL_ID=eleven_multilingual_v2
# Extra voices/models clients may request (comma separated). The defaults above
# are always allowed; anything else is rejected with 400.
ELEVENLABS_ALLOWED_VOICE_IDS=
ELEVENLABS_ALLOWED_MODEL_IDS=
# Speech-to-text model (scribe_v1 was retired by ElevenLabs in July 2026).
ELEVENLABS_STT_MODEL_ID=scribe_v2
# Language for STT and for TTS models that support language enforcement
# (Flash/Turbo v2.5, v3). multilingual_v2 detects the language from the text.
ELEVENLABS_LANGUAGE_CODE=id
# auto | on | off
ELEVENLABS_TEXT_NORMALIZATION=auto
ELEVENLABS_TTS_TIMEOUT_MS=15000
ELEVENLABS_STT_TIMEOUT_MS=20000
# Maximum characters per TTS request.
TTS_MAX_TEXT_LENGTH=300
# Maximum STT upload size in bytes (2 MB).
MAX_AUDIO_UPLOAD_BYTES=2097152
# Daily spending caps (UTC day, stored in PostgreSQL). When exhausted the voice
# endpoints return 503 VOICE_BUDGET_EXHAUSTED and the app uses on-device speech.
# Characters sent to TTS on cache misses per day (0 = cached audio only):
ELEVENLABS_DAILY_CHAR_BUDGET=20000
# Seconds of audio sent to STT per day (0 = STT disabled):
ELEVENLABS_DAILY_STT_SECONDS_BUDGET=1800
# Disk cache for generated audio (mount a volume here in Docker).
TTS_CACHE_ENABLED=true
# Maximum cache size; least recently used files are deleted beyond it.
TTS_CACHE_MAX_MB=256
# Default: <backend>/data/tts-cache (in Docker: /app/data/tts-cache).
TTS_CACHE_DIR=

# --- docker-compose.yml only -------------------------------------------------------
# Superuser of the bundled `db` service (used only inside the db container).
# POSTGRES_USER=kogo
# POSTGRES_PASSWORD=
# POSTGRES_DB=kogo_research
# Non-superuser role the API connects with (created on first start of the volume).
# APP_DB_USER=kogo_app
# APP_DB_PASSWORD=

# --- Tests only -----------------------------------------------------------------
# Disposable database for `npm run test:integration` (name must contain "test";
# the suite truncates tables and recreates the public schema).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/kogo_research_test
